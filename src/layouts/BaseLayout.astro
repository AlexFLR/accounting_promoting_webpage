---
import '@styles/global.css';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import { getLangFromUrl, useTranslations, type Lang } from '@i18n/utils';
import { languages } from '@i18n/ui';
import { switchLangPath } from '@i18n/utils';
import { localBusinessSchema } from '@/lib/schema';
import { site } from '@/data/site';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative URL of the social share image. */
  ogImage?: string;
  noindex?: boolean;
  /**
   * Languages this specific page exists in. Defaults to all of them.
   *
   * Pages with no translation must pass their own language only. Emitting an
   * `en` alternate that resolves to a Romanian page is worse than emitting
   * none — the crawler follows it, finds the wrong language, and distrusts
   * the rest of the hreflang set. Five of the seven service pages are
   * Romanian-only by design and pass ['ro'].
   */
  locales?: Lang[];
  /**
   * Opt this page into full-viewport scroll snapping. Off by default —
   * long-form service pages must never snap, they are read, not paged.
   */
  snap?: boolean;
}

const {
  title,
  description,
  ogImage = '/images/og-default.jpg',
  noindex = false,
  locales,
  snap = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const ogImageUrl = new URL(ogImage, Astro.site ?? site.url);

// hreflang — tells Google these pages are translations of each other rather
// than duplicate content. Restricted to the locales this page actually has.
const pageLocales: Lang[] = locales ?? (Object.keys(languages) as Lang[]);

const alternates = pageLocales.map((l) => ({
  lang: l,
  href: new URL(switchLangPath(Astro.url, lang, l), Astro.site ?? site.url).toString(),
}));

// x-default points at the default language when the page has one, otherwise
// at the only version that exists. A single-locale page still gets a
// self-referential hreflang, which is valid and states the page is complete.
const xDefault = alternates.find((a) => a.lang === 'ro') ?? alternates[0];
---

<html lang={lang} data-snap={snap ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Vollda is used by every heading on every page, so it is worth
        preloading — it removes the swap from the critical path. `crossorigin`
        is required for fonts even when same-origin; without it the browser
        fetches the file twice. Garamontio is NOT preloaded here: it is only
        used by article bodies, which preload it themselves. */}
    <link
      rel="preload"
      href="/fonts/vollda-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title} — {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema(lang))}
      is:inline
    />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
    <Header locales={pageLocales} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
