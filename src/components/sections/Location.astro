---
/**
 * Office details and the map.
 *
 * The map embed loads with the page (lazily). The NAP block is plain HTML
 * using the same strings as the LocalBusiness schema in the head — the two
 * must never disagree.
 */
import Section from '@components/ui/Section.astro';
import { site } from '@/data/site';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const mapsQuery = encodeURIComponent(`${site.name}, ${site.address.street}, ${site.address.postalCode} ${site.address.city}`);
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const embedSrc = `https://www.google.com/maps?q=${mapsQuery}&output=embed`;

const rows = [
  { ref: 'AD', label: t('office.address'), value: site.address.street },
  {
    ref: 'LOC',
    label: t('office.city'),
    value: `${site.address.postalCode} ${site.address.city}, ${site.address.region}`,
  },
  {
    ref: 'PR',
    label: t('office.hours'),
    value: `${t('office.hoursValue')}, ${site.hours[0].opens}–${site.hours[0].closes}`,
  },
];
---

<Section section="birou">
  <div class="loc">
    <div class="loc__info">
      <address class="reg">
        {
          rows.map((r) => (
            <div class="reg__row">
              <span class="reg__ref">{r.ref}</span>
              <span class="reg__main">
                <span class="reg__note">{r.label}</span>
                <span class="reg__title">{r.value}</span>
              </span>
            </div>
          ))
        }
        <div class="reg__row">
          <span class="reg__ref">TEL</span>
          <span class="reg__main">
            <span class="reg__note">{t('office.phone')}</span>
            <a class="reg__title" href={site.phoneHref}>{site.phone}</a>
          </span>
        </div>
        <div class="reg__row">
          <span class="reg__ref">@</span>
          <span class="reg__main">
            <span class="reg__note">{t('office.email')}</span>
            <a class="reg__title" href={`mailto:${site.email}`}>{site.email}</a>
          </span>
        </div>
      </address>

    </div>

    <figure class="map">
      <iframe
        class="map__frame"
        src={embedSrc}
        title={`Harta către biroul din ${site.address.city}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <figcaption class="map__note">
        <a href={mapsLink} target="_blank" rel="noopener">{t('map.open')}</a>
      </figcaption>
    </figure>
  </div>
</Section>

<style>
  .loc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--space-8);
    align-items: start;
  }

  @media (max-width: 56rem) {
    .loc {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  address {
    font-style: normal;
  }

  /* ── Map ────────────────────────────────────────────────────────────── */
  .map {
    margin: 0;
  }

  .map__frame {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface);
  }

  .map__note {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }
</style>
