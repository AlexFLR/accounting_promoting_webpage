---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/islands/ContactForm.astro';
import { useTranslations } from '@i18n/utils';

const t = useTranslations('ro');
---

<BaseLayout title={t('contact.heading')} description={t('hero.subtitle')}>
  <section class="section container">
    <h1>{t('contact.heading')}</h1>
    <ContactForm />
  </section>
</BaseLayout>

<style>
  /* Center the form column to match the other inner pages, instead of
     stranding it on the left of the wide container. */
  .container {
    max-width: calc(var(--width-content) + 2 * var(--space-6));
  }
</style>
