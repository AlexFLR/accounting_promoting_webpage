---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations, pathFor } from '@i18n/utils';

const lang = 'ro';
const t = useTranslations(lang);

const posts = (await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title={t('blog.title')} description={t('blog.description')} locales={['ro']}>
  <section class="section container">
    <h1>{t('blog.title')}</h1>
    <p>{t('blog.description')}</p>

    {
      posts.length === 0 ? (
        <p>{t('blog.empty')}</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <article>
                <h2>
                  <a href={`${pathFor('blog', lang)}/${post.id.replace(`${lang}/`, '')}`}>
                    {post.data.title}
                  </a>
                </h2>
                <p>{post.data.description}</p>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toLocaleDateString(lang)}
                </time>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .posts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  time {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
