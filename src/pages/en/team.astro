---
/**
 * Our team — the English counterpart of /echipa.
 *
 * Not a decorative "about" page. Accounting is a "your money or your life"
 * topic in Google's terms, where a named, credentialed human behind the
 * advice carries real ranking weight — and a foreign owner deciding whether
 * to hand over their Romanian filings has exactly the same question a
 * Romanian one does: who is actually doing this, and are they licensed.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Tbd from '@components/ui/Tbd.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title="Our team"
  description="Who keeps your books: CECCAR-licensed accountants based in Ploiești, working with foreign-owned Romanian companies. The same people from first email to annual accounts."
  locales={['ro', 'en']}
>
  <section class="team">
    <div class="container">
      <h1>Our team</h1>

      <p class="motto">“By your side all year — not just at the deadline.”</p>

      <p class="lede">
        We are an accounting practice in Ploiești, working with companies, sole
        traders and liberal professions since 2017. We keep the full set of books
        — from day-to-day entries and payroll to the annual accounts — and stay
        close throughout the year, not only around the deadlines. You speak to the
        same person every time, the one who actually keeps your books, not a call
        centre.
      </p>

      <ul class="stats">
        <li class="stat">
          <span class="stat__figure">{site.founded}</span>
          <span class="stat__label">founded</span>
        </li>
        <li class="stat">
          <span class="stat__figure">{site.clients.total}+</span>
          <span class="stat__label">satisfied clients</span>
        </li>
        <li class="stat">
          <span class="stat__figure">{site.clients.active}+</span>
          <span class="stat__label">active clients</span>
        </li>
      </ul>

      <h2>How we work</h2>

      <p>
        We commit to dates, not intentions. Documents received by the agreed day
        are recorded that month, and your trial balance and the statement of what
        is payable reach you before the filing deadlines, not on them.
      </p>

      <p>
        Questions are not billed. If you want to know how something will be taxed
        before you sign a contract, that question is part of the retainer —
        finding out afterwards always costs more than asking first.
      </p>

      <p>
        Correspondence and reporting are in English; filings go to the Romanian
        tax authority in Romanian. For complex tax advice, transfer pricing or
        disputes with ANAF we work with
        <Tbd label="parteneri / colaboratori externi" /> rather than improvising.
      </p>

      <h2>The office</h2>

      <p>
        {site.address.street}, {site.address.city}, {site.address.region} county.
        Monday to Friday, {site.hours[0].opens}–{site.hours[0].closes}. Documents
        can be brought in or sent scanned — for most clients, meeting in person is
        rare after the handover.
      </p>

      <p>
        We are registered with CECCAR, the Romanian body of chartered accountants,
        under authorisation no. {site.registration.ceccar ? site.registration.ceccar : <Tbd label="număr autorizație CECCAR a societății" />},
        and carry professional indemnity insurance of
        <Tbd label="plafon asigurare răspundere civilă" />.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .team {
    padding-block: var(--space-12) var(--space-24);
  }

  .motto {
    max-width: 26ch;
    margin: var(--space-6) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.15;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .lede {
    max-width: 58ch;
    font-size: var(--text-lg);
    color: var(--color-ink-body);
    margin-top: var(--space-4);
  }

  .stats {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: var(--space-6) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    border-top: 1px solid var(--color-line);
    max-width: var(--width-content);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat__figure {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  h2 {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    max-width: var(--width-content);
  }

  p {
    max-width: var(--width-content);
    margin-bottom: var(--space-4);
  }
</style>
