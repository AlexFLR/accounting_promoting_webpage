# Copy to .env and fill in. .env is gitignored.

# --- Contact form delivery ---
# Option A: Resend (needs a server adapter, see README)
RESEND_API_KEY=
CONTACT_TO_EMAIL=office@your-accounting-firm.com
CONTACT_FROM_EMAIL=website@your-accounting-firm.com

# Option B: Web3Forms / Formspree (no server needed, no adapter)
# This one is public — it is safe in client-side code.
PUBLIC_WEB3FORMS_KEY=

# --- Analytics (optional, privacy-friendly) ---
PUBLIC_PLAUSIBLE_DOMAIN=
